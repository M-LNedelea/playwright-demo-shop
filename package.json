{
  "name": "playwright-demo-shop",
  "version": "1.0.0",
  "description": "First attempt of creating a suite of automated tests using playwright",
  "keywords": [],
  "homepage": "https://github.com/M-LNedelea/playwright-demo-shop#readme",
  "bugs": {
